{
  "properties": {
    "activities": [
      {
        "type": "GetMetadata",
        "typeProperties": {
          "datasetSettings": {
            "type": "Binary",
            "typeProperties": {
              "location": {
                "type": "LakehouseLocation",
                "folderPath": {
                  "value": "@pipeline().parameters.p_raw_folder",
                  "type": "Expression"
                }
              }
            },
            "linkedService": {
              "name": "lh_sales_lab",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "25dfa9d5-c362-b894-4dfb-176e4f0f6635",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Files"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "fieldList": [
            "childItems"
          ],
          "storeSettings": {
            "type": "LakehouseReadSettings",
            "enablePartitionDiscovery": false
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Get_Raw_Files",
        "dependsOn": []
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('Get_Raw_Files').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().type, 'File'), endswith(item().name, '.csv'))",
            "type": "Expression"
          }
        },
        "name": "Filter_CSV_Files",
        "dependsOn": [
          {
            "activity": "Get_Raw_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@equals(activity('Filter_CSV_Files').output.FilteredItemsCount, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": "No CSV files found in the configured raw folder.",
                "errorCode": "ERR_NO_CSV_FILES"
              },
              "name": "Fail_No_Files",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "Guard_No_Files",
        "dependsOn": [
          {
            "activity": "Filter_CSV_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "items": {
            "value": "@activity('Filter_CSV_Files').output.Value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "DelimitedTextSource",
                  "formatSettings": {
                    "type": "DelimitedTextReadSettings"
                  },
                  "storeSettings": {
                    "type": "LakehouseReadSettings",
                    "recursive": true,
                    "enablePartitionDiscovery": false
                  },
                  "datasetSettings": {
                    "type": "DelimitedText",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": {
                          "value": "@pipeline().parameters.p_raw_folder",
                          "type": "Expression"
                        },
                        "fileName": {
                          "value": "@item().name",
                          "type": "Expression"
                        }
                      },
                      "columnDelimiter": ",",
                      "quoteChar": "\"",
                      "escapeChar": "\\",
                      "firstRowAsHeader": true
                    },
                    "schema": [],
                    "linkedService": {
                      "name": "lh_sales_lab",
                      "properties": {
                        "type": "Lakehouse",
                        "typeProperties": {
                          "artifactId": "25dfa9d5-c362-b894-4dfb-176e4f0f6635",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "rootFolder": "Files"
                        },
                        "annotations": []
                      }
                    },
                    "annotations": []
                  }
                },
                "sink": {
                  "type": "LakehouseTableSink",
                  "tableActionOption": "OverwriteSchema",
                  "applyVOrder": false,
                  "enableTimestampNtz": false,
                  "partitionOption": "None",
                  "datasetSettings": {
                    "type": "LakehouseTable",
                    "typeProperties": {
                      "schema": "dbo",
                      "table": {
                        "value": "@concat('raw_', replace(item().name, '.csv', ''))",
                        "type": "Expression"
                      }
                    },
                    "schema": [],
                    "linkedService": {
                      "name": "lh_sales_lab",
                      "properties": {
                        "type": "Lakehouse",
                        "typeProperties": {
                          "artifactId": "25dfa9d5-c362-b894-4dfb-176e4f0f6635",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "rootFolder": "Tables"
                        },
                        "annotations": []
                      }
                    },
                    "annotations": []
                  }
                },
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                },
                "enableStaging": false
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Copy_CSV_To_Table",
              "dependsOn": []
            }
          ]
        },
        "name": "Loop_CSV_Files",
        "dependsOn": [
          {
            "activity": "Guard_No_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "4304b3ff-debc-ad58-4d57-33c71deb9e7c",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {
            "run_date": {
              "value": "@utcNow('yyyy-MM-dd')",
              "type": "string"
            }
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Run_Sales_Transformations",
        "dependsOn": [
          {
            "activity": "Loop_CSV_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "RefreshSqlEndpoint",
        "typeProperties": {
          "workspaceId": "b71bda92-1195-43f9-9cc4-e4c1b0e4a734",
          "sqlEndpointId": "976f8a0d-3070-4e8f-b63b-bf29b0be2fdc",
          "recreateTables": false
        },
        "externalReferences": {
          "connection": "fabdec20-cad9-4872-8ced-756cf60f359f"
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Refresh_SQL_Endpoint",
        "dependsOn": [
          {
            "activity": "Run_Sales_Transformations",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "LakehouseTableSource"
          },
          "datasetSettings": {
            "type": "LakehouseTable",
            "typeProperties": {
              "schema": "dbo",
              "table": "sales_category_city_summary"
            },
            "schema": [],
            "linkedService": {
              "name": "lh_sales_lab",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "25dfa9d5-c362-b894-4dfb-176e4f0f6635",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Tables"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Lookup_Summary_Rows",
        "dependsOn": [
          {
            "activity": "Refresh_SQL_Endpoint",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_run_summary",
          "value": {
            "value": "@concat('Ingested ', string(activity('Filter_CSV_Files').output.FilteredItemsCount), ' CSVs; created ', string(activity('Lookup_Summary_Rows').output.count), ' summary rows on ', utcNow('yyyy-MM-dd'))",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set_Run_Summary",
        "dependsOn": [
          {
            "activity": "Lookup_Summary_Rows",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_raw_folder": {
        "type": "string",
        "defaultValue": "raw"
      }
    },
    "variables": {
      "v_run_summary": {
        "type": "String"
      }
    }
  }
}